# Copy to deploy/.env on the server (chmod 600). Never commit the real file.
DOMAIN=cadence.example.com
BETTER_AUTH_URL=https://cadence.example.com
# Permanent: encrypts LinkedIn tokens and the OAuth signing keys. Generate once: openssl rand -base64 48
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=
# From your LinkedIn app's Auth tab. Its redirect URL must be https://<DOMAIN>/api/auth/callback/linkedin.
# Empty or a placeholder (e.g. "preview") hides LinkedIn sign-in and publishing, and deploy/deploy.sh refuses to deploy.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
ANTHROPIC_API_KEY=
# Optional: email sign-in links and reminder emails. Without both, the login page offers LinkedIn only.
RESEND_API_KEY=
EMAIL_FROM=
# Optional: emails (comma-separated) that may open /app/admin/usage. Feature flags are set with `pnpm flag`.
CADENCE_ADMINS=
