# Copy to deploy/.env on the server (chmod 600). Never commit the real file.
DOMAIN=cadence.example.com
BETTER_AUTH_URL=https://cadence.example.com
# Permanent: encrypts LinkedIn tokens and the OAuth signing keys. Generate once: openssl rand -base64 48
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
ANTHROPIC_API_KEY=
# Optional: reminder emails
RESEND_API_KEY=
EMAIL_FROM=
