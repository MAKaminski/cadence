# Copy to deploy/.env on the server (chmod 600). Never commit the real file.
DOMAIN=cadence.example.com
BETTER_AUTH_URL=https://cadence.example.com
# Permanent: encrypts LinkedIn tokens and the OAuth signing keys. Generate once: openssl rand -base64 48
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=
# From your LinkedIn app's Auth tab. Its redirect URL must be https://<DOMAIN>/api/auth/callback/linkedin.
# Empty or a placeholder (e.g. "preview") hides LinkedIn sign-in and publishing. People need LinkedIn or email (below) to sign in;
# check with deploy/check-env.sh, or `pnpm signin:check` in the web container.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Post numbers (impressions, members reached, reactions, comments, reposts, saves, sends, link clicks, followers
# gained, profile views) read from LinkedIn 1, 3 and 7 days after each post. Needs your LinkedIn app approved for
# the Community Management API (scope r_member_postAnalytics); set 1 only after that, or LinkedIn sign-in fails.
# Members then sign in with LinkedIn once more to grant it. Until then, people add numbers by hand on Published.
LINKEDIN_ANALYTICS=
# Optional: X (Twitter). From your X developer app (User authentication: Web App, "Read and write"),
# callback URL https://<DOMAIN>/api/auth/callback/twitter. One app serves every user; nobody brings keys.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Needed for a new account to start its trial (/checkout). Owner without Stripe: `pnpm signin:link you@example.com --comp`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Optional: a yearly price on the same product at 20% off (12 × the monthly price × 0.8). When set,
# Settings → Billing offers "Switch to annual"; empty hides the offer.
STRIPE_ANNUAL_PRICE_ID=
ANTHROPIC_API_KEY=
# Email sign-in links and reminder emails (https://resend.com: API key, and a sender on a domain you verify there,
# e.g. EMAIL_FROM=Cadence <hello@example.com>). Without both, the login page offers LinkedIn only.
RESEND_API_KEY=
EMAIL_FROM=
# Optional: emails (comma-separated) that may open /app/admin/usage. Feature flags are set with `pnpm flag`.
CADENCE_ADMINS=
