{
  "name": "cadence-posts",
  "version": "0.4.0",
  "description": "Command-line client for Cadence: check in, review drafts and see results from your terminal.",
  "license": "MIT",
  "type": "module",
  "bin": { "cadence": "dist/cadence.mjs" },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=20" },
  "repository": { "type": "git", "url": "git+https://github.com/MAKaminski/cadence.git", "directory": "cli" },
  "homepage": "https://github.com/MAKaminski/cadence/tree/main/cli#readme",
  "keywords": ["linkedin", "cadence", "cli", "social-media", "ai"],
  "scripts": {
    "types": "openapi-typescript ../docs/openapi.json -o src/api.d.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/cadence.mjs --banner:js=#!/usr/bin/env\\ node"
  },
  "dependencies": {
    "commander": "15.0.0",
    "openapi-fetch": "0.17.0"
  }
}
