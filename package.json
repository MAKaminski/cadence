{
  "name": "cadence",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "scrub": "node scripts/scrub.mjs",
    "arch": "node scripts/erd.mjs",
    "arch:check": "node scripts/erd.mjs --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "worker": "tsx src/worker/index.ts",
    "worker:once": "tsx src/worker/index.ts --once",
    "demo": "node scripts/demo.mjs",
    "demo:record": "tsx scripts/demo/record.ts",
    "test:e2e": "playwright test",
    "build:worker": "esbuild src/worker/index.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=dist/worker.mjs",
    "catalog": "tsx scripts/catalog.ts",
    "catalog:check": "tsx scripts/catalog.ts --check",
    "openapi": "tsx scripts/openapi.mts",
    "openapi:check": "tsx scripts/openapi.mts --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@base-ui/react": "^1.8.0",
    "@better-auth/api-key": "1.7.6",
    "@better-auth/oauth-provider": "1.7.6",
    "@better-auth/stripe": "1.7.6",
    "@hono/zod-openapi": "^1.6.3",
    "@hookform/resolvers": "^5.9.1",
    "@modelcontextprotocol/server": "2.1.0",
    "@scalar/nextjs-api-reference": "^0.12.4",
    "@tanstack/react-query": "5.104.0",
    "better-auth": "1.7.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "0.45.3",
    "hono": "^4.13.9",
    "lucide-react": "1.48.0",
    "mcp-handler": "2.2.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.89.0",
    "recharts": "3.8.0",
    "resend": "6.30.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "2.0.8",
    "stripe": "22.6.2",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "drizzle-kit": "0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.0.2"
  },
  "packageManager": "pnpm@11.22.0",
  "description": "LinkedIn posts in your own voice, from two minutes a week. Open-source, multi-user, Claude-written drafts checked against your own facts, published through LinkedIn's official API.",
  "license": "MIT",
  "homepage": "https://github.com/MAKaminski/cadence#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/MAKaminski/cadence.git"
  },
  "bugs": {
    "url": "https://github.com/MAKaminski/cadence/issues"
  },
  "keywords": [
    "linkedin",
    "social-media",
    "scheduler",
    "ai",
    "claude",
    "anthropic",
    "nextjs",
    "postgres",
    "saas",
    "open-source"
  ]
}
